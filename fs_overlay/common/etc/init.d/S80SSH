#!/bin/sh
##
 # @file S80SSH
 # @date 2026/09/29
 #
 # @brief OpenSSH server manager for the VOT X2000 board (house style, like
 #        S60WiFi and S70USB).
 #
 # @note Replaces both the buildroot script and the earlier vendor adaptation:
 #       - the vendor's APP_br_ssh copied a config out of the data partition on a
 #         read-only rootfs; on our writable UBIFS that whole scheme was dead
 #         weight and failed silently (settings were pruned in round 4);
 #       - buildroot's S50sshd only asks "does the key file exist". A zero-length
 #         key file therefore kept sshd dead FOREVER: a board with no RTC and a
 #         freshly seeded random pool can leave ssh_host_*_key at 0 bytes, sshd
 #         then exits with "no hostkeys available", and the board becomes
 #         unreachable - which is exactly what happened here once.
 #
 # @note Design rules kept from the sibling scripts:
 #       - verify what you depend on, never assume: host keys are checked for
 #         VALIDITY (non-empty and parseable), not for existence;
 #       - repair what can be repaired and say so: unusable keys, wrong config
 #         modes, missing privilege separation directory;
 #       - report the truth: FAILED (with sshd -e output on the console) instead
 #         of a cheerful OK, and status shows every prerequisite;
 #       - start late (S80): the network is up by then, so the console log and the
 #         board's address are already settled when SSH comes up.
 #
 # @note Authentication is the factory account: user root, password from
 #       products/<product>.conf, installed into /etc/shadow at build time by
 #       scripts/pack_images.sh. Public-key authentication is off in
 #       etc/ssh/sshd_config; the 'authorized' verb is there for the case where
 #       someone enables it again.
 #
 # @note Host keys live in the writable UBIFS rootfs, so they persist across
 #       reboots. They are regenerated by 'reflash' (new image) or by 'keys'.
 #
 # Usage: S80SSH {start|stop|restart|status|keys|debug|authorized}
 #
 #   start       ensure keys/config and start sshd (the boot action)
 #   stop        stop sshd
 #   restart     stop, then start
 #   status      process, listening port, host keys, config modes, login state
 #   keys        regenerate the host keys (fixes the 0-byte-key trap by hand)
 #   debug       run sshd in the foreground with -e -d (Ctrl-C to stop)
 #   authorized  install /usr/data/ssh/authorized_keys into /root/.ssh
 #
 # Environment overrides: SSH_DIR, SSH_PORT, AUTH_KEYS_SRC.
 #

SSH_DIR="${SSH_DIR:-/etc/ssh}"
SSHD="${SSHD:-/usr/sbin/sshd}"
SSH_KEYGEN="${SSH_KEYGEN:-/usr/bin/ssh-keygen}"
PRIVSEP_DIR="${PRIVSEP_DIR:-/var/empty}"
RUN_DIR="${RUN_DIR:-/run/sshd}"
SHADOW_FILE="${SHADOW_FILE:-/etc/shadow}"
AUTH_KEYS_SRC="${AUTH_KEYS_SRC:-/usr/data/ssh/authorized_keys}"
AUTH_KEYS_DST="${AUTH_KEYS_DST:-/root/.ssh/authorized_keys}"
SSH_PORT="${SSH_PORT:-22}"

log() { echo "[S80SSH] $*"; }

# ---------------------------------------------------------------------------
# Part I: Func_* (one function, one job)
# ---------------------------------------------------------------------------

##
 # @brief True when the process is running.
 #
 # @note pidof, not "pgrep -x": busybox' -x compares the WHOLE command line, so
 #       "pgrep -x sshd" never matches "/usr/sbin/sshd -e" and every check here
 #       reported "not running" while the daemon was happily serving.
 #
 # @param $1 process name
 #
Func_running() {
    pidof "$1" >/dev/null 2>&1
}
# End-func Func_running

##
 # @brief Permission string of a file/directory, e.g. "-rw-r--r--".
 #
 # @note Uses ls(1) instead of stat(1): busybox in this image is built without the
 #       stat applet ("stat: not found"), which silently produced empty results.
 #
 # @param $1 path
 #
Func_perms() {
    ls -ld "$1" 2>/dev/null | awk '{print $1}'
}
# End-func Func_perms

##
 # @brief True when group or other may write the given path.
 #
 # @note openssh refuses such a sshd_config ("Bad owner or permissions"), so the
 #       check looks at the group-write (position 6) and other-write (position 9)
 #       characters of the ls(1) permission string.
 #
 # @param $1 path
 #
Func_group_writable() {
    case "$(Func_perms "$1")" in
        ?????w*|????????w) return 0 ;;
        *) return 1 ;;
    esac
}
# End-func Func_group_writable

##
 # @brief Owner of a path as "user:group" (empty when it does not exist).
 #
 # @param $1 path
 #
Func_owner() {
    ls -ld "$1" 2>/dev/null | awk '{print $3":"$4}'
}
# End-func Func_owner

##
 # @brief True when a host key file exists and actually holds a readable key.
 #
 # @param $1 path to a key (private) or public key file
 #
Func_key_usable() {
    [ -s "$1" ] && "$SSH_KEYGEN" -l -f "$1" >/dev/null 2>&1
}
# End-func Func_key_usable

##
 # @brief Make sure every host key type exists and is valid.
 #
 # @note This is the fix for the 0-byte-key trap: anything unusable (missing,
 #       empty, truncated) is deleted first, then all types are regenerated and
 #       the result is verified before it is used.
 #
Func_keys_ensure() {
    local f regen=0

    for f in "$SSH_DIR"/ssh_host_*_key "$SSH_DIR"/ssh_host_*_key.pub; do
        [ -e "$f" ] || continue
        if ! Func_key_usable "$f"; then
            log "removing unusable key file $(basename "$f")"
            rm -f "$f"
        fi
    done

    [ -f "$SSH_DIR/ssh_host_rsa_key" ] || regen=1
    [ "$regen" = "1" ] || return 0

    log "generating host keys (first boot, after a reflash, or keys were unusable)"
    "$SSH_KEYGEN" -A

    if ! Func_key_usable "$SSH_DIR/ssh_host_rsa_key"; then
        log "ERROR: no usable RSA host key after ssh-keygen -A"
        log "       size of $SSH_DIR/ssh_host_rsa_key: $(wc -c < "$SSH_DIR/ssh_host_rsa_key" 2>/dev/null) bytes"
        df -h / | sed 's/^/[S80SSH] /'
        log "       hints: rootfs full, or the random pool was not ready (retry: $0 keys)"
        return 1
    fi

    log "host keys ready: $(ls -1 "$SSH_DIR"/ssh_host_*_key 2>/dev/null | wc -l) key type(s)"
    return 0
}
# End-func Func_keys_ensure

##
 # @brief Make the files and permissions sshd insists on.
 #
 # @note openssh aborts on a group/world-writable sshd_config ("Bad owner or
 #       permissions") and on a privilege separation directory it does not own
 #       ("%s must be owned by root and not group or world-writable"), so both are
 #       checked and corrected here instead of being trusted.
 #
Func_config_check() {
    local cfg="$SSH_DIR/sshd_config"

    if [ -f "$cfg" ]; then
        if Func_group_writable "$cfg"; then
            log "fixing permissions of $cfg ($(Func_perms "$cfg") -> 644)"
            chmod 644 "$cfg"
        fi
    else
        log "WARN: $cfg is missing, sshd will fall back to built-in defaults"
    fi

    if [ ! -d "$PRIVSEP_DIR" ]; then
        mkdir -p "$PRIVSEP_DIR"
        log "created privilege separation directory $PRIVSEP_DIR"
    fi
    chown 0:0 "$PRIVSEP_DIR" 2>/dev/null
    chmod 755 "$PRIVSEP_DIR"

    mkdir -p "$RUN_DIR"
}
# End-func Func_config_check

##
 # @brief Install optional public keys from the writable data partition.
 #
 # @note Not required for the factory login (password auth). Kept because the
 #       data partition is what MTP exposes on the host, so it is the natural
 #       place to drop a key when someone switches pubkey auth back on.
 #
Func_authorized_install() {
    [ -f "$AUTH_KEYS_SRC" ] || return 0

    mkdir -p /root/.ssh
    chmod 700 /root/.ssh
    cp -f "$AUTH_KEYS_SRC" "$AUTH_KEYS_DST"
    chmod 600 "$AUTH_KEYS_DST"
    log "authorized_keys installed from $AUTH_KEYS_SRC"
    return 0
}
# End-func Func_authorized_install

##
 # @brief Is sshd listening? Reads /proc/net/tcp directly - netstat/sockstat may
 #        not be in a small image.
 #
Func_port_listening() {
    local hexport
    hexport="$(printf '%04X' "$SSH_PORT")"

    grep -q -i ":$hexport " /proc/net/tcp  /proc/net/tcp6 2>/dev/null
}
# End-func Func_port_listening

##
 # @brief Start (or ensure) the SSH server.
 #
Func_start() {
    Func_keys_ensure || { log "cannot start sshd without host keys"; return 1; }
    Func_config_check
    Func_authorized_install

    if Func_port_listening; then
        log "sshd already listening on port $SSH_PORT"
        return 0
    fi

    log "starting sshd"
    # -e keeps the error messages on the console instead of syslog, so a failure
    # is visible where the operator already is
    if "$SSHD" -e; then
        log "sshd started: ssh root@<board-ip>, port $SSH_PORT"
        return 0
    fi

    log "FAILED to start sshd - see the messages above"
    log "hint: run '$0 debug' for a foreground run with full debug output"
    return 1
}
# End-func Func_start

##
 # @brief Stop the SSH server.
 #
Func_stop() {
    if ! Func_running sshd; then
        log "sshd is not running"
        return 0
    fi

    log "stopping sshd"
    killall sshd 2>/dev/null
    sleep 1

    if Func_running sshd; then
        log "WARN: sshd is still running"
        return 1
    fi
    return 0
}
# End-func Func_stop

##
 # @brief Print everything a human needs to judge "can I log in?".
 #
Func_status() {
    local rc=0

    if Func_running sshd; then
        log "process: running (pid $(pidof sshd | cut -d' ' -f1))"
    else
        log "process: NOT running"
        rc=1
    fi

    if Func_port_listening; then
        log "listening: yes, tcp/$SSH_PORT"
    else
        log "listening: NO on tcp/$SSH_PORT"
        rc=1
    fi

    log "host keys: $(ls -1 "$SSH_DIR"/ssh_host_*_key 2>/dev/null | wc -l) type(s) present"
    if Func_key_usable "$SSH_DIR/ssh_host_rsa_key"; then
        log "rsa key: usable ($(wc -c < "$SSH_DIR/ssh_host_rsa_key" 2>/dev/null) bytes)"
    else
        log "rsa key: MISSING OR UNUSABLE - fix with '$0 keys'"
        rc=1
    fi

    if [ -f "$SSH_DIR/sshd_config" ]; then
        log "config: $(Func_perms "$SSH_DIR/sshd_config") $(Func_owner "$SSH_DIR/sshd_config") $SSH_DIR/sshd_config"
        log "auth: $(grep -h -E '^(PasswordAuthentication|PubkeyAuthentication)' "$SSH_DIR/sshd_config" 2>/dev/null | tr '\n' ' ')"
    else
        log "config: MISSING ($SSH_DIR/sshd_config)"
    fi

    log "privsep: $(Func_owner "$PRIVSEP_DIR") $(Func_perms "$PRIVSEP_DIR") $PRIVSEP_DIR"

    case "$(awk -F: '$1=="root"{print $2}' "$SHADOW_FILE" 2>/dev/null)" in
        ''|'x'|'*'|'!'*) log "root password: NOT set (password login is impossible)" ;;
        *)               log "root password: set (factory default from products/*.conf)" ;;
    esac

    return $rc
}
# End-func Func_status

##
 # @brief Regenerate all host keys (clients will see a new fingerprint).
 #
Func_keys_regen() {
    log "regenerating host keys - connected clients will complain about the fingerprint"
    rm -f "$SSH_DIR"/ssh_host_*_key "$SSH_DIR"/ssh_host_*_key.pub
    Func_keys_ensure
}
# End-func Func_keys_regen

##
 # @brief Run sshd in the foreground with debug output (console debugging).
 #
Func_debug() {
    Func_keys_ensure || return 1
    Func_config_check
    log "running sshd in the foreground (-e -d); press Ctrl-C to stop"
    "$SSHD" -e -d
}
# End-func Func_debug

# ---------------------------------------------------------------------------
# Part III: main
# ---------------------------------------------------------------------------

case "$1" in
    start)      Func_start ;;
    stop)       Func_stop ;;
    restart)    Func_stop; Func_start ;;
    status)     Func_status ;;
    keys)       Func_keys_regen ;;
    debug)      Func_debug ;;
    authorized) Func_authorized_install ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|keys|debug|authorized}"
        exit 1
        ;;
esac

exit $?
