# /etc/ssh/sshd_config - VOT X2000 board (Darwin_X2000_V2.1.1)
#
# Replaces the vendor's copy. The vendor ships this file inside /save and copies
# it into place at boot (an adaptation for a read-only root filesystem). Our
# root filesystem is writable UBIFS and the SSH layout is plain /etc/ssh, so no
# indirection is needed - and the old scheme failed silently.
#
# Notes:
#   - Host keys do not exist at build time; /etc/init.d/S50sshd generates them
#     on first boot with "ssh-keygen -A".
#   - Authentication is the factory account from products/<product>.conf:
#     user root, password installed as a SHA-512 crypt hash into /etc/shadow by
#     scripts/pack_images.sh (products/darwin_v211.conf, section "factory login").
#     The serial console uses the same account (busybox login reads /etc/shadow).
#   - Public keys are switched OFF on purpose: a factory image should not need
#     anyone to provision a key on the board. To use keys instead, set
#     "PubkeyAuthentication yes" and copy the key to /root/.ssh/authorized_keys
#     (the root filesystem is writable, so it survives a reboot).
#   - internal-sftp avoids spawning /usr/libexec/sftp-server for SFTP sessions.

Port 22
AddressFamily any

HostKey /etc/ssh/ssh_host_rsa_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_ed25519_key

# Boards and clients in this project use older RSA keys
HostKeyAlgorithms +ssh-rsa
PubkeyAcceptedKeyTypes +ssh-rsa

# factory account: password authentication only
PermitRootLogin yes
PasswordAuthentication yes
PubkeyAuthentication no
PermitEmptyPasswords no
AuthorizedKeysFile .ssh/authorized_keys

UseDNS no
PrintMotd no
PidFile /var/run/sshd.pid

Subsystem sftp internal-sftp
