+    error = dlerror();
+    if (error)
+        goto dl_error;
+
+    func_name = "camera_get_frame";
+    camera_get_frame = dlsym(handle, func_name);
+    error = dlerror();
+    if (error)
+        goto dl_error;
+
+    func_name = "camera_put_frame";
+    camera_put_frame = dlsym(handle, func_name);
+    error = dlerror();
+    if (error)
+        goto dl_error;
+
+    func_name = "camera_dqbuf";
+    camera_dqbuf = dlsym(handle, func_name);
+    error = dlerror();
