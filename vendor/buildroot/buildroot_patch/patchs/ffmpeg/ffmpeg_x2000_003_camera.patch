diff -Naur ffmpeg-4.2.2/libavdevice/x2000_camera_dec.c ffmpeg-4.2.2-2/libavdevice/x2000_camera_dec.c
--- ffmpeg-4.2.2/libavdevice/x2000_camera_dec.c	1970-01-01 08:00:00.000000000 +0800
+++ ffmpeg-4.2.2-2/libavdevice/x2000_camera_dec.c	2022-12-06 11:33:00.013528723 +0800
@@ -0,0 +1,294 @@
+#include <dirent.h>
+#include <unistd.h>
+#include <unistd.h>
+
+#include "libavutil/internal.h"
+#include "libavutil/log.h"
+#include "libavutil/mem.h"
+#include "libavutil/opt.h"
+#include "libavutil/time.h"
+#include "libavutil/parseutils.h"
+#include "libavutil/pixdesc.h"
+#include "libavformat/internal.h"
+#include "avdevice.h"
+
+#include "x2000_camera.c"
+struct x2000_camera_data {
+    AVClass *class;
+    int fd;
+
+    int frame_nums;
+    struct camera_info info;
+
+    int time_offset;
+
+    void *handle;           ///< dlopen handle
+};
+
+static int x2000_camera_read_header(AVFormatContext *ctx)
+{
+    struct x2000_camera_data *s = ctx->priv_data;
+    AVStream *st;
+    int res = 0;
+
+    s->handle = load_x2000_camera_lib();
+    if (!s->handle) {
+        av_log(ctx, AV_LOG_ERROR, "Could not open libhardware2.so\n");
+        return AVERROR(ENODEV);
+    }
+
+    st = avformat_new_stream(ctx, NULL);
+    if (!st) {
+        unload_x2000_camera_lib(s->handle);
+        return AVERROR(ENOMEM);
+    }
+
+    avpriv_set_pts_info(st, 64, 1, 1000000); /* 64 bits pts in us */
+
+    s->fd = camera_open(&s->info, ctx->url);
+    if (s->fd < 0) {
+        unload_x2000_camera_lib(s->handle);
+        av_log(ctx, AV_LOG_ERROR, "Could not open x2000 camera device\n");
+        return s->fd;
+    }
+
+    res = camera_power_on(s->fd);
+    if (res < 0) {
+        camera_close(s->fd, &s->info);
+        unload_x2000_camera_lib(s->handle);
+        return res;
+    }
+
+    res = camera_stream_on(s->fd);
+    if (res) {
+        camera_close(s->fd, &s->info);
+        unload_x2000_camera_lib(s->handle);
+        return res;
+    }
+
+    st->codecpar->codec_type = AVMEDIA_TYPE_VIDEO;
+    st->codecpar->codec_id   = AV_CODEC_ID_RAWVIDEO;
+    st->codecpar->width      = s->info.width;
+    st->codecpar->height     = s->info.height;
+    st->codecpar->format     = AV_PIX_FMT_NV12;
+    st->avg_frame_rate.num       = s->info.fps;
+    st->avg_frame_rate.den       = 1;
+    st->codecpar->bit_rate   = s->info.line_length * s->info.height * 3 / 2 * s->info.fps * 8;
+
+    return 0;
+}
+
+static void yuyv_to_nv12(void *_dst, void *_src, int xres, int yres, int line_length)
+{
+    int len = xres * yres;
+    unsigned char *y = _dst;
+    unsigned char *uv = _dst + len;
+    unsigned char *start = _src;
+    unsigned char *s0 = _src + 1;
+    unsigned char *s1 = s0 + line_length;
+    int i, j;
+
+    /* 处理Y分量 */
+    for (i = 0; i < yres; i++) {
+        for (j = 0; j < xres * 2; j = j + 2) {
+            *(y++) = start[j];
+        }
+        start += line_length;
+    }
+
+    /* 处理UV分量 */
+    for (j = 0; j < yres; j = j + 2) {
+        for (i = 0; i < xres * 2; i = i + 4) {
+            uv[0] = (s0[0 + i] + s1[0 + i]) / 2;
+            uv[1] = (s0[2 + i] + s1[2 + i]) / 2;
+            uv += 2;
+        }
+        s0 += 2 * line_length;
+        s1 = s0 + line_length;
+    }
+}
+
+static void simple_bayer16_to_nv12(void *_dst, void *_src, int width, int height, int line_length)
+{
+    unsigned int len = line_length * height;
+    unsigned char *src = _src + 1;
+    unsigned char *dst = _dst;
+    int i, j;
+    for (i = 0; i < height; i++) {
+        for (j = 0; j < width * 2; j = j + 2) {
+            *(dst++) = src[j];
+        }
+        src += line_length;
+    }
+
+    memset(dst, 0x80, len / 4);
+
+}
+
+static void y8_to_nv12(void *_dst, void *_src, int width, int height, int line_length)
+{
+    unsigned char *src = _src;
+    unsigned char *dst = _dst;
+
+    for (int i = 0; i < height; i++) {
+        memcpy(dst, src, width);
+        src += line_length;
+        dst += width;
+    }
+    memset(dst, 0x80, width * (height / 2));
+}
+
+static int x2000_camera_read_packet(AVFormatContext *ctx, AVPacket *pkt)
+{
+    int res, height, width;
+    struct frame_info frame;
+    struct x2000_camera_data *s = ctx->priv_data;
+    int input_format = s->info.data_fmt;
+    int line_length = s->info.line_length;
+
+    res = camera_dqbuf_wait(s->fd, &frame);
+    if (res)
+        return AVERROR(EAGAIN);
+
+    height = frame.height;
+    width = frame.width;
+    res = av_new_packet(pkt, height * width * 3 / 2);
+    if (res == 0) {
+        switch (input_format) {
+        case CAMERA_PIX_FMT_YUYV:
+            yuyv_to_nv12(pkt->data, frame.vaddr, width, height, line_length);
+            break;
+        case CAMERA_PIX_FMT_Y16:
+        case CAMERA_PIX_FMT_SBGGR16:
+        case CAMERA_PIX_FMT_SGBRG16:
+        case CAMERA_PIX_FMT_SGRBG16:
+        case CAMERA_PIX_FMT_SRGGB16:
+            simple_bayer16_to_nv12(pkt->data, frame.vaddr, width, height, line_length);
+            break;
+        case CAMERA_PIX_FMT_GREY:
+            y8_to_nv12(pkt->data, frame.vaddr, width, height, line_length);
+            break;
+        case CAMERA_PIX_FMT_NV12:
+        case CAMERA_PIX_FMT_NV21:
+            memcpy(pkt->data, frame.vaddr, frame.size);
+            break;
+        default:
+            av_log(ctx, AV_LOG_ERROR, "Unsupport input format \n");
+            return AVERROR(ENOENT);
+    }
+        pkt->pts = av_gettime() + s->time_offset;
+        s->time_offset = 0;
+        res = frame.size;
+    }
+    camera_qbuf(s->fd, &frame);
+
+    return res;
+}
+
+static int x2000_camera_read_close(AVFormatContext *ctx)
+{
+    struct x2000_camera_data *s = ctx->priv_data;
+
+    camera_drop_frames(s->fd, s->info.frame_nums);
+
+    camera_stream_off(s->fd);
+
+    camera_power_off(s->fd);
+
+    camera_close(s->fd, &s->info);
+
+    unload_x2000_camera_lib(s->handle);
+    return 0;
+}
+
+static int is_x2000_camera_dev(const char *name)
+{
+    if (strncmp(name, "vic", 3) == 0 || strncmp(name, "cim", 3) == 0|| strncmp(name, "cam", 3) == 0)
+        return 1;
+
+    return 0;
+}
+
+static int x2000_camera_get_device_list(AVFormatContext *ctx, AVDeviceInfoList *device_list)
+{
+    DIR *dir;
+    struct dirent *entry;
+    AVDeviceInfo *device = NULL;
+    int ret = 0;
+
+    if (!device_list)
+        return AVERROR(EINVAL);
+
+    dir = opendir("/dev");
+    if (!dir) {
+        ret = AVERROR(errno);
+        av_log(ctx, AV_LOG_ERROR, "Couldn't open the directory: %s\n", av_err2str(ret));
+        return ret;
+    }
+    while ((entry = readdir(dir))) {
+        char device_name[256];
+
+        if (!is_x2000_camera_dev(entry->d_name))
+            continue;
+
+        device = av_mallocz(sizeof(AVDeviceInfo));
+        if (!device) {
+            ret = AVERROR(ENOMEM);
+            goto fail;
+        }
+
+        snprintf(device_name, sizeof(device_name), "/dev/%s", entry->d_name);
+        device->device_name = av_strdup(device_name);
+        device->device_description = av_strdup(entry->d_name);
+        if (!device->device_name || !device->device_description) {
+            ret = AVERROR(ENOMEM);
+            goto fail;
+        }
+
+        if ((ret = av_dynarray_add_nofree(&device_list->devices, &device_list->nb_devices, device)) < 0)
+            goto fail;
+
+        continue;
+
+      fail:
+        if (device) {
+            av_freep(&device->device_name);
+            av_freep(&device->device_description);
+            av_freep(&device);
+        }
+        break;
+    }
+    closedir(dir);
+    return ret;
+}
+
+#define OFFSET(x) offsetof(struct x2000_camera_data, x)
+#define DEC AV_OPT_FLAG_DECODING_PARAM
+
+static const AVOption options[] = {
+    { "frame_nums",      "set frame nums",               OFFSET(frame_nums),      AV_OPT_TYPE_INT,    {.i64 = 2 },  1, INT_MAX, DEC },
+
+    { "time_offset",      "first pts time offset [unit:us]",   OFFSET(time_offset),      AV_OPT_TYPE_INT,    {.i64 = 0 },  INT_MIN, INT_MAX, DEC },
+
+    { NULL },
+};
+
+static const AVClass x2000_camera_class = {
+    .class_name = "x2000 camera",
+    .item_name  = av_default_item_name,
+    .option     = options,
+    .version    = LIBAVUTIL_VERSION_INT,
+    .category   = AV_CLASS_CATEGORY_DEVICE_VIDEO_INPUT,
+};
+
+AVInputFormat ff_x2000_camera_demuxer = {
+    .name           = "x2000_camera",
+    .long_name      = NULL_IF_CONFIG_SMALL("x2000 camera"),
+    .priv_data_size = sizeof(struct x2000_camera_data),
+    .read_header    = x2000_camera_read_header,
+    .read_packet    = x2000_camera_read_packet,
+    .read_close     = x2000_camera_read_close,
+    .get_device_list = x2000_camera_get_device_list,
+    .flags          = AVFMT_NOFILE,
+    .priv_class     = &x2000_camera_class,
+};
