menuconfig APP_br_adc_set_voltage
    bool "开机根据adc读取电压设置VDDIO_CIM/VDDIO_SD"
    default n
    help
               +++   vddio_cim (3.3v or 1.8v)
                |
                |
               [ ]
               [ ]   R0
                |
     adc _______|
                |
               [ ]  R1
               [ ]
                |
                |
               ---   GND
        ADC_CIM = VDDIO_CIM * R1 / (R0 + R1)

menuconfig APP_br_adc_set_vddio_cim_voltage
    bool "adc 设置 VDDIO_CIM"
    default n

config APP_br_adc_set_vddio_cim_adc_ch
    int "VDDIO CIM 电路上接通的 adc 通道"
    choice from APP_br_gpio_voltage_adc_channel_choice

config APP_br_adc_set_vddio_cim_r0
    int "VDDIO CIM 分压电阻 R0 (ADC_CIM = VDDIO_CIM * R1 / (R0 + R1))"
    default 100000
    help
               +++   vddio_cim (3.3v or 1.8v)
                |
                |
               [ ]
               [ ]   R0
                |
     adc _______|
                |
               [ ]  R1
               [ ]
                |
                |
               ---   GND
        ADC_CIM = VDDIO_CIM * R1 / (R0 + R1)

config APP_br_adc_set_vddio_cim_r1
    int "VDDIO CIM 分压电阻 R1(详见R0描述)"
    default 100000
    help
        ADC_CIM = VDDIO_CIM * R1 / (R0 + R1)

endmenu # APP_br_adc_set_vddio_cim_voltage

menuconfig APP_br_adc_set_vddio_sd_voltage
    bool "adc 设置 VDDIO_SD"
    default n

config APP_br_adc_set_vddio_sd_adc_ch
    int "VDDIO SD 电路上接通的 adc 通道"
    choice from APP_br_gpio_voltage_adc_channel_choice

config APP_br_adc_set_vddio_sd_r0
    int "VDDIO SD 分压电阻 R0 (ADC_SD = VDDIO_SD * R1 / (R0 + R1))"
    default 100000
    help
               +++   vddio_sd (3.3v or 1.8v)
                |
                |
               [ ]
               [ ]   R0
                |
     adc _______|
                |
               [ ]  R1
               [ ]
                |
                |
               ---   GND
        ADC_SD = VDDIO_SD * R1 / (R0 + R1)

config APP_br_adc_set_vddio_sd_r1
    int "VDDIO SD 分压电阻 R1(详见R0描述)"
    default 100000
    help
        ADC_SD = VDDIO_SD * R1 / (R0 + R1)

endmenu # APP_br_adc_set_vddio_sd_voltage


endmenu # APP_br_adc_set_voltage

array APP_br_gpio_voltage_adc_channel_choice
    int "adc 可选通道(不同芯片adc通道数不同)"
    item "AUX0" 0
    item "AUX1" 1
    item "AUX2" 2
    item "AUX3" 3
    item "AUX4" 4
    item "AUX5" 5
    item "AUX6" 6
    item "AUX7" 7
    item "AUX8" 8
    item "AUX9" 9
    item "AUX10" 10
    item "AUX11" 11
    item "AUX12" 12
    item "AUX13" 13
    item "AUX14" 14
    item "AUX15" 15
