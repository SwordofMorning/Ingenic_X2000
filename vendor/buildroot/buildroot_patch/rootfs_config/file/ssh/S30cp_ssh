#!/bin/sh
#

copy_ssh_files()
{
    local str;
    local file;
    str=`ls /save/etc/ssh/`

    for file in $str
    do
        if [ ! -f /etc/ssh/$file ]; then
            cp /save/etc/ssh/$file /etc/ssh/
        fi
    done
}

case "$1" in
  start)
    mkdir -p /usr/data/ssh/
    copy_ssh_files
	;;
  stop)

	;;
  restart|reload)
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?


