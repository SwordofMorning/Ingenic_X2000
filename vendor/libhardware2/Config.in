menuconfig APP_libhardware2
    bool "libhardware2 (片上外设的接口/命令)"
    default y

menuconfig APP_libhardware2_fb
    bool "fb(framebuffer显示接口)"
    default n

config APP_libhardware2_fb_cmd
    bool "fb shell命令"
    default n

config APP_libhardware2_fb_rector_play
    bool "俄罗斯方块程序,基于adc按键"
    default n

config APP_libhardware2_fb_scale_cmd
    bool "fb预览nv12图像格式缩放"
    default n

endmenu

config APP_libhardware2_fb_layer_mixer
    bool "fb_layer_mixer(fb图层叠加接口)"
    default n

menuconfig APP_libhardware2_v4l2
    bool "vpu(x2000/x2600/ad100)"
    default n

menuconfig APP_libhardware2_v4l2_jpeg_encode
    bool "x2000 jpeg 编码选项"
    default n
config APP_libhardware2_camera_jpeg_encode
    bool "camera jpeg编码命令(通过v4l2将Camera输出的图像编码成jpeg格式)"
    default n
endmenu #"x2000 jpeg 编码选项"

menuconfig APP_libhardware2_v4l2_jpeg_decode
    bool "x2000 jpeg 解码选项"
    default n
config APP_libhardware2_jpeg_decode_cmd
    bool "硬件jpeg解码命令 (x2000)"
    default n
endmenu #"x2000 jpeg 解码选项"

menuconfig APP_libhardware2_v4l2_h264_encode
    bool "x2000 h264 编码选项"
    default n
config APP_libhardware2_camera_h264_encode
    bool "camera h264编码命令(通过v4l2将Camera输出的图像编码成h264格式)"
    default n
endmenu #"x2000 h264 编码选项"

menuconfig APP_libhardware2_v4l2_h264_decode
    bool "x2000/x2600/ad100 h264 解码选项"
    default n
config APP_libhardware2_h264_decode_cmd
    bool "硬件h264解码命令 (输出后拷贝到rmem)"
    default n
config APP_libhardware2_h264_direct_decode_cmd
    bool "硬件h264解码命令 (直通模式:指定输出地址)"
    default n
endmenu #"x2000/x2600/ad100 h264 解码选项"

endmenu

menuconfig APP_libhardware2_avpu
