menuconfig MD_FCS950UAB
	bool "FCS950UAB wireless cards support"

config MD_FCS950UAB_SDIO
	bool "SDIO bus interface support"
	default y

config MD_FCS950UAB_MMC_NUM
	int "wlan_mmc_num (mmc/sdio 总线号)"
	default -1
	help
	  wifi 挂接在哪个 mmc 总线,比如 0, 1

config MD_FCS950UAB_BT_WIFI_POWER
	string "gpio_bt_wifi_power(控制整个bt,wifi模块的供电)"
	default -1
	choice from SOC_GPIO_PINS

config MD_FCS950UAB_BT_WIFI_POWER_VALID_LEVEL
	string "gpio_bt_wifi_power_valid_level(bt,wifi模块供电引脚的有效电平)"
	default 0
	choice from MD_GPIO_ACTIVE_LEVEL

config MD_FCS950UAB_WLAN_REG_ON
	string "gpio_wlan_reg_on(wifi的使能引脚)"
	default -1
	choice from SOC_GPIO_PINS

config MD_FCS950UAB_WLAN_WAKE_HOST
	string "gpio_wlan_wake_host(wifi 唤醒/中断 cpu 的引脚)"
	default -1
	choice from SOC_GPIO_PINS

config MD_FCS950UAB_AP_IRQ
	string "gpio_ap_irq(wifi ap中断引脚)"
	default -1
	choice from SOC_GPIO_PINS

endmenu