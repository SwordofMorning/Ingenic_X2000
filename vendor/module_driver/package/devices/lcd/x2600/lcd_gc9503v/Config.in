menuconfig MD_X2600_LCD_GC9503V
    bool "TFT GC9503V (480x480) (X2600)"
    select MD_X2600_510_FB
    depends on MD_SOC_X2600_BASE

config MD_X2600_GC9503V_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_GC9503V_POWER_EN
    string "gpio power enable(lcd power使能引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_GC9503V_SPI_SCL
    string "spi clk(时钟引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_GC9503V_SPI_SDA
    string "spi sda(mosi 输出引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_GC9503V_SPI_CS
    string "spi cs(片选脚)"
    choice from SOC_GPIO_PINS
    default -1

endmenu # MD_X2600_LCD_GC9503V
