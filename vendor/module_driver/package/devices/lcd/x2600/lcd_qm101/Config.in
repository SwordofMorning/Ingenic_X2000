menuconfig MD_X2600_LCD_QM101
    bool "TFT QM101 (1024 x 600) (X2600) (lvds接口)"
    select MD_X2600_510_FB
    depends on MD_SOC_X2600_BASE

config MD_X2600_QM101_POWER_EN
    string "gpio power enable(lcd power使能引脚 不设置则使用regulator) "
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_QM101_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_QM101_LCD_BACKLIGHT_ENABLE
    string "gpio backlight enable(lcd backlight背光使能)(lcd 读引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_QM101_REGULATOR_NAME
    string "regulator name(通过名字获取 lcd module 电源管理器)"
    default -1

endmenu # MD_X2600_LCD_QM101
