menuconfig MD_X2600_LCD_YC101
    bool "TFT YC101 (800x1280) (X2600) (mipi接口)"
    select MD_X2600_510_FB
    depends on MD_SOC_X2600_BASE

config MD_X2600_YC101_4LANE_ON
    bool "使能 4lane 通道"
    default n

config MD_X2600_YC101_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_YC101_POWER_EN
    string "gpio power(lcd power使能引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_YC101_REGULATOR_NAME
    string "regulator name(通过名字获取 lcd module 电源管理器)"
    default -1

endmenu # MD_X2600_LCD_YC101
