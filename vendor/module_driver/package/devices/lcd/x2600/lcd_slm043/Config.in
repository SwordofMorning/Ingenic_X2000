menuconfig MD_X2600_LCD_SLM043
    bool "TFT SLM043 (480x272) (X2600) (tft serial 8bit接口)"
    select MD_X2600_510_FB
    depends on MD_SOC_X2600_BASE

config MD_X2600_SLM043_POWER_EN
    string "gpio power enable(lcd power使能引脚)"
    choice from SOC_GPIO_PINS
    default -1

endmenu # MD_X2600_LCD_SLM043
