menuconfig MD_X2600_LCD_ST7789V_4LINE_SPI
    bool "SLCD ST7789V (240x320) (X2600) (4line_spi接口)"
    select MD_X2600_510_FB
    depends on MD_SOC_X2600_BASE


config MD_X2600_ST7789V_4LINE_SPI_CS
    string "gpio chip select(lcd 片选引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_ST7789V_4LINE_SPI_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_ST7789V_4LINE_SPI_POWER_EN
    string "gpio power enable(lcd power使能引脚)"
    choice from SOC_GPIO_PINS
    default -1

endmenu # MD_X2600_LCD_ST7789V_4LINE_SPI