menuconfig MD_X2600_LCD_TF450
    bool "TFT TF450 (480 x 854) (X2600) (mipi接口)"
    select MD_X2600_510_FB
    depends on MD_SOC_X2600_BASE

config MD_X2600_TF450_POWER_EN
    string "gpio power enable(lcd power使能引脚 不设置则使用regulator) "
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_TF450_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_TF450_LCD_BACKLIGHT_ENABLE
    string "gpio backlight enable(lcd backlight背光使能)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_TF450_REGULATOR_NAME
    string "regulator name(通过名字获取 lcd module 电源管理器)"
    default -1

endmenu # MD_X2600_LCD_TF450
