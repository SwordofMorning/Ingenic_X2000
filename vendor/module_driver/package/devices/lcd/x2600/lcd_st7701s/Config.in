menuconfig MD_X2600_LCD_ST7701S
    bool "TFT ST7701S (480 x 800) (X2600) (mipi接口)"
    select MD_X2600_510_FB
    depends on MD_SOC_X2600_BASE

config MD_X2600_ST7701S_POWER_EN
    string "gpio power enable(lcd power使能引脚 不设置则使用regulator) "
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_ST7701S_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_ST7701S_LCD_BACKLIGHT_ENABLE
    string "gpio backlight enable(lcd backlight背光使能)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2600_ST7701S_REGULATOR_NAME
    string "regulator name(通过名字获取 lcd module 电源管理器)"
    default -1

endmenu # MD_X2600_LCD_ST7701S
