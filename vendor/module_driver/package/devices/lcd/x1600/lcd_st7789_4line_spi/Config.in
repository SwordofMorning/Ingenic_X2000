menuconfig MD_X1600_LCD_ST7789_4LINE_SPI
    bool "SLCD ST7789 4LINE_SPI(240*320) (X1600)"
    select MD_X1600_FB
    depends on MD_SOC_X1600_BASE

config MD_X1600_ST7789_4LINE_SPI_CS
    string "gpio chip select(lcd 片选引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X1600_ST7789_4LINE_SPI_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X1600_ST7789_4LINE_SPI_POWER_EN
    string "gpio power enable(lcd power使能引脚)"
    choice from SOC_GPIO_PINS
    default -1

endmenu # MD_X1600_LCD_ST7789_4LINE_SPI