menuconfig MD_X2000_LCD_MS7024
    bool "TFT MS7024 (720x480) (X2000)"
    select MD_X2000_FB
    depends on MD_SOC_X2000_BASE

config MD_X2000_MS7024_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_MS7024_POWER_EN
    string "gpio power(lcd power使能引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_MS7024_POWER_VALID_LEVEL
	string "power_valid_level(供电引脚的有效电平)"
	default 0
	choice from MD_GPIO_ACTIVE_LEVEL

config MD_X2000_MS7024_REGULATOR_NAME
    string "regulator name(通过名字获取 lcd module 电源管理器)"
    default -1

config MD_X2000_MS7024_I2C_BUS_NUM
	int "i2c bus num (sensor 挂接的i2c总线号)"
	default -1

endmenu # MD_X2000_LCD_MS7024