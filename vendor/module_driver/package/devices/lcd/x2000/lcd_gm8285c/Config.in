menuconfig MD_X2000_LCD_GM8285C
    bool "TFT GM8285C (1024x768) (X2000)"
    select MD_X2000_FB
    depends on MD_SOC_X2000_BASE

config MD_X2000_GM8285C_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_GM8285C_POWER_EN
    string "gpio power(lcd power使能引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2000_GM8285C_POWER_VALID_LEVEL
	string "power_valid_level(供电引脚的有效电平)"
	default 0
	choice from MD_GPIO_ACTIVE_LEVEL

endmenu # MD_X2000_LCD_GM8285C