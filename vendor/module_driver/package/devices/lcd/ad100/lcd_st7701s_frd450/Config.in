menuconfig MD_AD100_LCD_ST7701S_FRD450
    bool "TFT ST7701S_FRD450 (480x854) (AD100) (mipi接口)"
    select MD_AD100_510_FB
    depends on MD_SOC_AD100_BASE

config MD_AD100_ST7701S_FRD450_BACKLIGHT_EN
    string "gpio backlight enable(lcd backlight使能引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_AD100_ST7701S_FRD450_RST
    string "gpio reset(lcd 复位引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_AD100_ST7701S_FRD450_POWER_EN
    string "gpio power(lcd power使能引脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_AD100_ST7701S_FRD450_REGULATOR_NAME
    string "regulator name(通过名字获取 lcd module 电源管理器)"
    default -1

endmenu # MD_AD100_LCD_ST7701S_FRD450