menuconfig MD_X2580_SENSOR_AR0234_MIPI
    bool "sensor ar0234 (mipi,raw8)"
    select MD_X2580_CAMERA_VIC_DOUBLE
    depends on MD_SOC_X2580_BASE

menuconfig MD_X2580_SENSOR0_AR0234
    bool "sensor0 config"

config MD_X2580_AR0234_SENSOR0_NAME
    string "sensor module name"
    default "ar0234-0"

config MD_X2580_AR0234_GPIO_RESET0
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_AR0234_GPIO_POWER0
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_AR0234_REGULATOR_NAME0
    string "regulator name(通过名字获取 sensor module 电源管理器)"
    default "GPIO-POWER0"

config MD_X2580_AR0234_I2C_BUSNUM0
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

config MD_X2580_AR0234_I2C_ADDR0
    int "i2c device addr (sensor的i2c地址)"
    default 0x10
endmenu # MD_X2580_SENSOR0_AR0234


menuconfig MD_X2580_SENSOR1_AR0234
    bool "sensor1 config"
    select MD_X2580_SENSOR0_AR0234

config MD_X2580_AR0234_SENSOR1_NAME
    string "sensor module name"
    default "ar0234-1"

config MD_X2580_AR0234_GPIO_RESET1
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_AR0234_GPIO_POWER1
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_AR0234_REGULATOR_NAME1
    string "regulator name(通过名字获取 sensor module 电源管理器)"
    default "GPIO-POWER0"

config MD_X2580_AR0234_I2C_BUSNUM1
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

config MD_X2580_AR0234_I2C_ADDR1
    int "i2c device addr (sensor的i2c地址)"
    default 0x18
endmenu # MD_X2580_SENSOR1_AR0234

endmenu # MD_X2580_SENSOR_AR0234_MIPI
