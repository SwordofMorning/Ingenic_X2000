menuconfig MD_X2580_SENSOR_OG02B10_MIPI
    bool "sensor og02b10 (mipi,raw10)"
    select MD_X2580_CAMERA_VIC
    depends on MD_SOC_X2580_BASE

config MD_X2580_OG02B10_SENSOR_NAME
    string "sensor module name"
    default "og02b10"

config MD_X2580_OG02B10_GPIO_PWDN
    string "gpio pwdn(sensor 使能引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_OG02B10_GPIO_POWER
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_OG02B10_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

config MD_X2580_OG02B10_I2C_ADDR
    int "i2c device addr (sensor的i2c地址)"
    default -1

config MD_X2580_OG02B10_CAM_BUSNUM
    int "cam bus num (sensor 挂接的vic/cim总线号)"
    default -1

endmenu # MD_X2580_SENSOR_OG02B10_MIPI
