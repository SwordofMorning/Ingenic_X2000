menuconfig MD_X2580_SENSOR_GC4663_MIPI
    bool "sensor gc4663 (mipi,raw10)"
    select MD_X2580_CAMERA_VIC
    depends on MD_SOC_X2580_BASE

config MD_X2580_GC4663_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_GC4663_GPIO_PWDN
    string "gpio pwdn(sensor 使能引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_GC4663_GPIO_POWER
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_GC4663_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

endmenu # MD_X2580_SENSOR_GC4663_MIPI
