menuconfig MD_X2580_SENSOR_SC132_MIPI
    bool "sensor sc132 (mipi,raw8)"
    select MD_X2580_CAMERA_VIC
    depends on MD_SOC_X2580_BASE

config MD_X2580_SC132_GPIO_RESET
    string "gpio reset(sensor 复位脚)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_SC132_GPIO_PWDN
    string "gpio pwdn(sensor 电源控制引脚, 低有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_SC132_GPIO_POWER
    string "gpio power(sensor 电源控制引脚, 高有效)"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_SC132_I2C_BUSNUM
    int "i2c bus num (sensor 挂接的i2c总线号)"
    default -1

endmenu # MD_X2580_SENSOR_SC132_MIPI
