menuconfig MD_AD100_510_UTILS
    bool "utils 驱动(芯片的一些小功能)"

config MD_AD100_510_UTILS_CLK24M
    bool "clk24m 时钟bypas输出(PE02)"
    default y

config MD_AD100_510_UTILS_CLK24M_INIT_ON
    bool "        初始化即使能clk24m输出"
    depends on MD_AD100_510_UTILS_CLK24M

config MD_AD100_510_UTILS_RTC32K
    bool "rtc32k 时钟bypas输出(PE00) (未实现)"
    default y

config MD_AD100_510_UTILS_RTC32K_INIT_ON
    bool "        初始化即使能rtc32k输出"
    depends on MD_AD100_510_UTILS_RTC32K

endmenu
