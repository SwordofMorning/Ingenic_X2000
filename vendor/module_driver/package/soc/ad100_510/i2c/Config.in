menuconfig MD_AD100_510_I2C
    bool "i2c 控制器驱动"


config MD_AD100_510_I2C0_BUS
    bool "选择I2C0"

choice "              选择I2C0 GPIO"
    default MD_AD100_510_I2C0_PC
    depends on MD_AD100_510_I2C0_BUS

config MD_AD100_510_I2C0_PC
    bool "SCL:GPIO_PC(0) SDA:GPIO_PC(1)"

config MD_AD100_510_I2C0_PD
    bool "SCL:GPIO_PD(4) SDA:GPIO_PD(3)"

endchoice

config MD_AD100_510_I2C0_RATE
    int "       I2C0 速度 "
    default 400000
    depends on MD_AD100_510_I2C0_BUS



config MD_AD100_510_I2C1_BUS
    bool "选择I2C1"

choice "              选择I2C1 GPIO"
    default MD_AD100_510_I2C1_PB
    depends on MD_AD100_510_I2C1_BUS

config MD_AD100_510_I2C1_PB
    bool "SCL:GPIO_PB(0) SDA:GPIO_PB(1)"

config MD_AD100_510_I2C1_PC
    bool "SCL:GPIO_PC(2) SDA:GPIO_PC(3)"

endchoice

config MD_AD100_510_I2C1_RATE
    int "        I2C1 速度 "
    default 400000
    depends on MD_AD100_510_I2C1_BUS



config MD_AD100_510_I2C2_BUS
    bool "选择I2C2"

choice "              选择I2C2 GPIO"
    default MD_AD100_510_I2C2_PB
    depends on MD_AD100_510_I2C2_BUS

config MD_AD100_510_I2C2_PB
    bool "SCL:GPIO_PB(3) SDA:GPIO_PB(2)"

config MD_AD100_510_I2C2_PC
    bool "SCL:GPIO_PC(19) SDA:GPIO_PC(20)"

endchoice

config MD_AD100_510_I2C2_RATE
    int "       I2C2 速度 "
    default 400000
    depends on MD_AD100_510_I2C2_BUS



config MD_AD100_510_I2C3_BUS
    bool "选择I2C3"

choice "              选择I2C3 GPIO"
    default MD_AD100_510_I2C3_PE
    depends on MD_AD100_510_I2C3_BUS

config MD_AD100_510_I2C3_PE
    bool "SCL:GPIO_PE(5) SDA:GPIO_PE(6)"

config MD_AD100_510_I2C3_PC
    bool "SCL:GPIO_PC(21) SDA:GPIO_PC(22)"

endchoice

config MD_AD100_510_I2C3_RATE
    int "       I2C3 速度 "
    default 400000
    depends on MD_AD100_510_I2C3_BUS



endmenu
