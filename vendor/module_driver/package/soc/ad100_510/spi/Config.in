array SOC_AD100_510_SPI0_CLK_IO
    string "SPI0 CLK 引脚"
    item "GPIO_NULL  " -1
    item "PB03" PB03
    item "PD00" PD00

array SOC_AD100_510_SPI0_MISO_IO
    string "SPI0 MISO(DR) 引脚"
    item "GPIO_NULL  " -1
    item "PB01" PB01
    item "PD02" PD02

array SOC_AD100_510_SPI0_MOSI_IO
    string "SPI0 MOSI(DT) 引脚"
    item "GPIO_NULL  " -1
    item "PB02" PB02
    item "PD01" PD01


array SOC_AD100_510_SPI0_CLK_I1
    string "SPI0 CLK 引脚"
    item "GPIO_NULL  " -1
    item "PC15" PC15
    item "PC25" PC25

array SOC_AD100_510_SPI0_MISO_I1
    string "SPI0 MISO(DR) 引脚"
    item "GPIO_NULL  " -1
    item "PC17" PC17
    item "PC27" PC27

array SOC_AD100_510_SPI0_MOSI_I1
    string "SPI0 MOSI(DT) 引脚"
    item "GPIO_NULL  " -1
    item "PC16" PC16
    item "PC26" PC26



menu "SPI 总线"
    help
        "依赖于 SPI 驱动"

config MD_AD100_510_SPI
    bool

config MD_AD100_510_SPI_CLK_RATE
    int "SPI内部时钟源频率(单位Hz)"
    default 100000000
    help
            SPI频率 = SPI内部时钟源频率 / (2 * (CGV + 1))
            CGV范围: 0 ~ 255
            当前SPI频率范围: 195312.5 ~ 50000000



config MD_AD100_510_SPI0
    bool "选择 SPI0"
    select MD_AD100_510_SPI

config MD_AD100_510_SPI0_CLK
    string "        CLK(时钟引脚)"
    default PD00
    choice from SOC_AD100_510_SPI0_CLK_IO
    depends on MD_AD100_510_SPI0

config MD_AD100_510_SPI0_MISO
    string "        MISO(输入引脚)"
    default PD02
    choice from SOC_AD100_510_SPI0_MISO_IO
    depends on MD_AD100_510_SPI0
    help
        "MISO= -1,表示不使用MISO引脚"

config MD_AD100_510_SPI0_MOSI
    string "        MOSI(输出引脚)"
    default PD01
    choice from SOC_AD100_510_SPI0_MOSI_IO
    depends on MD_AD100_510_SPI0
    help
        "MOSI= -1,表示不使用MOSI引脚"


config MD_AD100_510_SPI1
    bool "选择 SPI1"
    select MD_AD100_510_SPI

config MD_AD100_510_SPI1_CLK
    string "        CLK(时钟引脚)"
    default PC25
    choice from SOC_AD100_510_SPI0_CLK_I1
    depends on MD_AD100_510_SPI1

config MD_AD100_510_SPI1_MISO
    string "        MISO(输入引脚)"
    default PC27
    choice from SOC_AD100_510_SPI0_MISO_I1
    depends on MD_AD100_510_SPI1
    help
        "MISO= -1,表示不使用MISO引脚"

config MD_AD100_510_SPI1_MOSI
    string "        MOSI(输出引脚)"
    default PC26
    choice from SOC_AD100_510_SPI0_MOSI_I1
    depends on MD_AD100_510_SPI1
    help
        "MOSI= -1,表示不使用MOSI引脚"

endmenu # SPI 总线