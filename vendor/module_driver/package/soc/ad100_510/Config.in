source package/soc/ad100_510/adc/Config.in
source package/soc/ad100_510/audio_dma/Config.in
source package/soc/ad100_510/icodec/Config.in
source package/soc/ad100_510/dmic/Config.in
source package/soc/ad100_510/hash/Config.in
source package/soc/ad100_510/msc/Config.in
source package/soc/ad100_510/pwm/Config.in
source package/soc/ad100_510/spi/Config.in
source package/soc/ad100_510/sslv/Config.in
source package/soc/ad100_510/i2c/Config.in
source package/soc/ad100_510/fb_layer_mixer/Config.in
source package/soc/ad100_510/fb/Config.in
source package/soc/ad100_510/aic/Config.in
