menuconfig MD_X2580_ICODEC
    bool "icodec(内部codec)"
    select MD_X2580_AIC

config MD_X2580_ICODEC_BAIS_ON
    bool "开启偏置电压（录音时打开）"
    default y
    help
        对于外接的模拟mic,内部codec需要提前打开偏置电压
        对于回采电路，则不需要打开偏置电压

config MD_X2580_ICODEC_BAIS_LEVEL
    int "偏置电压的寄存器数值(范围0-7)"
    default 7

config MD_X2580_ICODEC_SPK_GPIO
    string "功放引脚"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_ICODEC_SPK_GPIO_LEVEL
    string "功放引脚使能电平"
    choice from MD_GPIO_ACTIVE_LEVEL
    default 1

config MD_X2580_ICODEC_SPK_NEED_DELAY_MS
    int "功放引脚使能后需要的延时时间(ms)"
    default 20
    help
        部分功放芯片的时序需要在使能功放引脚后加一定的延时

config MD_X2580_ICODEC_MAX_HPOUT_VAL
    int "外放音量最大值(对应寄存器CHPOUTLGR的[0,4],可填范围是0到31)"
    default 31
    help
        其中0代表-39dB，26代表0dB,31代表6dB.增加1，音量增加1.5dB

config MD_X2580_ICODEC_MIN_HPOUT_VAL
    int "外放音量最小值(对应寄存器CHPOUTLGR的[0,4],可填范围是0到31)"
    default 0
    help
        其中0代表-39dB，26代表0dB,31代表6dB.增加1，音量增加1.5dB

endmenu
