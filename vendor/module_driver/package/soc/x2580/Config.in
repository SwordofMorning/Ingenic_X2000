source package/soc/x2580/mac/Config.in
source package/soc/x2580/aes/Config.in
source package/soc/x2580/rsa/Config.in
source package/soc/x2580/camera/Config.in
source package/soc/x2580/camera-double/Config.in
source package/soc/x2580/mcu_riscv/Config.in
source package/soc/x2580/utils/Config.in
source package/soc/x2580/msc/Config.in
source package/soc/x2580/spi/Config.in
source package/soc/x2580/dbox/Config.in
source package/soc/x2580/aic/Config.in
source package/soc/x2580/icodec/Config.in
source package/soc/x2580/audio_dma/Config.in
