array SOC_X2580_CAMERA_MCLK_IO
    string "X2580 MCLK 引脚"
    item "PC15" PC15
    item "PA15" PA15

menuconfig MD_X2580_CAMERA_VIC_DOUBLE
    bool "camera 双摄驱动(vic控制器)"
    select MD_RMEM_MANAGER

config MD_X2580_CAMERA_VIC_DOUBLE_CTL
    bool "选择VIC控制器"
    default y

config MD_X2580_CAMERA_VIC_DOUBLE_MCLK
    string "VIC MCLK管脚选择"
    default PA15
    choice from SOC_X2580_CAMERA_MCLK_IO
    depends on MD_X2580_CAMERA_VIC_DOUBLE_CTL

config MD_X2580_CAMERA_VIC_DOUBLE_GPIO_MIPI_SWITCH
    string "VIC 双摄切换引脚"
    default -1
    choice from SOC_GPIO_PINS
    depends on MD_X2580_CAMERA_VIC_DOUBLE_CTL

choice "      选择VIC 数据通路(ISP/DDR)"
    default MD_X2580_CAMERA_VIC_DOUBLE_ISP_DISABLE
    depends on MD_X2580_CAMERA_VIC_DOUBLE_CTL

config MD_X2580_CAMERA_VIC_DOUBLE_ISP_DISABLE
    bool "    VIC数据不通过ISP模块"

config MD_X2580_CAMERA_VIC_DOUBLE_ISP_ENABLE
    bool "    VIC数据通过ISP模块"

endchoice

config MD_X2580_CAMERA_VIC_DOUBLE_FRAME_NUMS
    int "VIC Camera 帧缓冲数 "
    default 2
    depends on MD_X2580_CAMERA_VIC_DOUBLE_CTL

endmenu
