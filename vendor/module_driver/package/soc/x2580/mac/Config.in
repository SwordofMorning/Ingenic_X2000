menuconfig MD_X2580_MAC
    bool "mac 以太网控制器驱动"

array MAC_PHY_MDC
    int "设置PHY MDIO时钟"
    item " 根据phy clk自动计算 " 0xff
    item " MDC=18.75MHz " 0x0
    item " MDC=11.54HMz " 0x1
    item " MDC=7.14MHz " 0x2
    item " MDC=4.84MHz " 0x3
    item " MDC=2.94MHz " 0x4
    item " MDC=2.42MHz " 0x5

config MD_X2580_PHY_PROBE_MASK
    int "PHY探测屏蔽(范围：0x0～0xffffffff)"
    default 0x0
    help
        phy探测屏蔽为32位代表32个地址(0:使能探测 1:屏蔽探测)
        例如：0xfffffff0(探测前4个地址)

config MD_X2580_PHY_CLK_DELAY_US
    int "PHY CLK 使能后延迟时间再通讯(单位：us)"
    default 0

config MD_X2580_PHY_RESET_TIME_US
    int "PHY复位时间(单位：us)"
    default 10000

config MD_X2580_PHY_RESET_GPIO
    string "PHY 复位引脚"
    choice from SOC_GPIO_PINS
    default -1

config MD_X2580_PHY_VALID_LEVEL
    string "PHY 复位电平"
    choice from PHY_RESET_LEVEL
    default 0

config MD_X2580_PHY_MDC
    string "MAC PHY MDIO 时钟"
    choice from MAC_PHY_MDC
    default 0xff

config MD_X2580_VIRTUAL_PHY
    bool "外接虚拟phy设备，RMII直接通讯，用于两个mac互接省略phy芯片或用于直接与FPGA芯片通讯"
    default n

endmenu

array PHY_RESET_LEVEL
    string "RESET_LEVEL"
    item "RESET_LEVEL" 0
    item "RESET_LEVEL" 1
