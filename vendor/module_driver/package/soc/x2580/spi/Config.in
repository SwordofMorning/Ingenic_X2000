array SOC_x2580_SPI0_MISO_IO
    string "SPI0 MISO(DR) 引脚"
    item "GPIO_NULL  " -1
    item "PA09" PA09
    item "PC05" PC05

array SOC_x2580_SPI0_MOSI_IO
    string "SPI0 MOSI(DT) 引脚"
    item "GPIO_NULL  " -1
    item "PA08" PA08
    item "PC04" PC04

array SOC_x2580_SPI0_CLK_IO
    string "SPI0 CLK 引脚"
    item "GPIO_NULL  " -1
    item "PA06" PA06
    item "PC02" PC02



array SOC_x2580_SPI1_MISO_IO
    string "SPI1 MISO(DR) 引脚"
    item "GPIO_NULL  " -1
    item "PA21" PA21
    item "PB29" PB29

array SOC_x2580_SPI1_MOSI_IO
    string "SPI1 MOSI(DT) 引脚"
    item "GPIO_NULL  " -1
    item "PA20" PA20
    item "PB27" PB27

array SOC_x2580_SPI1_CLK_IO
    string "SPI1 CLK 引脚"
    item "GPIO_NULL  " -1
    item "PA22" PA22
    item "PB28" PB28



menu "SPI 总线"
    help
        "依赖于 SPI 驱动"

config MD_x2580_SPI
    bool

config MD_x2580_SPI_CLK_RATE
    int "SPI内部时钟源频率(单位Hz)"
    default 100000000
    help
            SPI频率 = SPI内部时钟源频率 / (2 * (CGV + 1))
            CGV范围: 0 ~ 255
            当前SPI频率范围: 195312.5 ~ 50000000

config MD_x2580_SPI0
    bool "选择 SPI0"
    select MD_x2580_SPI

config MD_x2580_SPI0_MISO
    string "        MISO(输入引脚)"
    default PA09
    choice from SOC_x2580_SPI0_MISO_IO
    depends on MD_x2580_SPI0
    help
        "MISO= -1,表示不使用MISO引脚"

config MD_x2580_SPI0_MOSI
    string "        MOSI(输出引脚)"
    default PA08
    choice from SOC_x2580_SPI0_MOSI_IO
    depends on MD_x2580_SPI0
    help
        "MOSI= -1,表示不使用MOSI引脚"

config MD_x2580_SPI0_CLK
    string "        CLK(时钟引脚)"
    default PA06
    choice from SOC_x2580_SPI0_CLK_IO
    depends on MD_x2580_SPI0


config MD_x2580_SPI1
    bool "选择 SPI1"
    select MD_x2580_SPI

config MD_x2580_SPI1_MISO
    string "        MISO(输入引脚)"
    default PA21
    choice from SOC_x2580_SPI1_MISO_IO
    depends on MD_x2580_SPI1
    help
        "MISO= -1,表示不使用MISO引脚"

config MD_x2580_SPI1_MOSI
    string "        MOSI(输出引脚)"
    default PA20
    choice from SOC_x2580_SPI1_MOSI_IO
    depends on MD_x2580_SPI1
    help
        "MOSI= -1,表示不使用MOSI引脚"

config MD_x2580_SPI1_CLK
    string "        CLK(时钟引脚)"
    default PA22
    choice from SOC_x2580_SPI1_CLK_IO
    depends on MD_x2580_SPI1

endmenu # SPI 总线