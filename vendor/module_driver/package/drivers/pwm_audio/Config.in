
config MD_PWM_AUDIO
    bool "PMW 模拟声卡驱动"
    default n

config MD_PWM_AUDIO_PWM_GPIO_1
    string "声卡1 pwm 引脚"
    choice from SOC_GPIO_PINS
    depends on MD_PWM_AUDIO
    default -1

config MD_PWM_AUDIO_AMP_POWER_GPIO_1
    string "声卡1 功放使能引脚"
    choice from SOC_GPIO_PINS
    depends on MD_PWM_AUDIO
    default -1

config MD_PWM_AUDIO_AMP_MUTE_UP_TIME_1
    string "声卡1 功放使能前时需要输出静音时间(ms)"
    default 1

config MD_PWM_AUDIO_AMP_MUTE_DOWN_TIME_1
    string "声卡1 功放失能后时需要输出静音时间(ms)"
    default 500

config MD_PWM_AUDIO_PWM_GPIO_2
    string "声卡2 pwm 引脚"
    choice from SOC_GPIO_PINS
    depends on MD_PWM_AUDIO
    default -1

config MD_PWM_AUDIO_AMP_POWER_GPIO_2
    string "声卡2 功放使能引脚"
    choice from SOC_GPIO_PINS
    depends on MD_PWM_AUDIO
    default -1


config MD_PWM_AUDIO_AMP_MUTE_UP_TIME_2
    string "声卡2 功放使能前时需要输出静音时间(ms)"
    default 1

config MD_PWM_AUDIO_AMP_MUTE_DOWN_TIME_2
    string "声卡2 功放失能后需要输出静音时间(ms)"
    default 500