{
    "version": "0.2.0",
    "configurations": [

       // GDB Debugging:
       {
          "program": "${workspaceFolder}/libmcu-bare.elf",
          "name": "Launch (gdb)",
          "request": "launch",
          "args": [],
          "stopAtEntry": false,
          "cwd": "${workspaceFolder}",
          "externalConsole": false,
          "internalConsoleOptions": "openOnSessionStart",
          "type": "cppdbg",
          "MIMode": "gdb",
          "miDebuggerPath": "${workspaceFolder}/../tools/toolchains/riscv-r1.0.0/bin/riscv32-ingenicv0-elf-gdb",
          "miDebuggerArgs": "",
          "miDebuggerServerAddress": "localhost:3333",
          "targetArchitecture": "mips",
          "preLaunchTask": "build",
          "customLaunchSetupCommands": [
             {
                "description": "gdb 启用整齐打印",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
             },
             {
                "text":"file ${workspaceFolder}/libmcu-bare.elf",
                "ignoreFailures": false
             },
             {
                "text": "target remote localhost:3333",
                "ignoreFailures": false
             },
             {
                "text": "monitor reset halt",
                "ignoreFailures": false
             },
             {
                "text": "load",
                "ignoreFailures": false
             },
             {
                "text": "source  ${workspaceFolder}/.vscode/connect_with_xburst2.gdb",
                "ignoreFailures": false
             },
          ],
          "logging": {
             "engineLogging": true,
          }
       }
    ]
 }