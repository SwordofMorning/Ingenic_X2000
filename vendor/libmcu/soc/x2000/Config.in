menuconfig APP_libmcu_x2000
    bool "x2000 小核配置"
    depends on APP_libmcu_choice_x2000

config APP_libmcu_x2000_irq
    bool "irq 中断处理驱动"
    select APP_libmcu_driver_irq
    default y

config APP_libmcu_x2000_clk
    bool "clk 驱动"
    select APP_libmcu_driver_clk
    default y

config APP_libmcu_x2000_gpio
    bool "gpio 驱动"
    select APP_libmcu_driver_gpio
    default y
    help
        使用该驱动需要在 kernel 内勾选 CONFIG_INGENIC_DISABLE_GPIO_UAE_SHADOW

config APP_libmcu_x2000_systick
    bool "systick timer驱动"
    select APP_libmcu_driver_systick

config APP_libmcu_x2000_tcu
    bool "tcu 驱动(gpio 时钟计数捕获)"
    select APP_libmcu_driver_tcu
    default y

config APP_libmcu_x2000_adc
    bool "adc 驱动"
    select APP_libmcu_driver_adc
    default n

source soc/x2000/config_i2c.in

source soc/x2000/config_uart.in
source soc/x2000/config_pwm.in

endmenu
