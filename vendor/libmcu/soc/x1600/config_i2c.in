menuconfig APP_libmcu_x1600_i2c
    bool "I2C 控制器驱动"
    select APP_libmcu_driver_i2c

config APP_libmcu_x1600_I2C0_BUS
    bool "选择 I2C0"

choice "              选择I2C0 GPIO"
    default APP_libmcu_x1600_I2C0_PA
    depends on APP_libmcu_x1600_I2C0_BUS

config APP_libmcu_x1600_I2C0_PA
    bool "SDA: GPIO_PA(29)、SCL: GPIO_PA(28)"

config APP_libmcu_X1600_I2C0_PB
    bool "SDA: GPIO_PB(31)、SCL: GPIO_PB(30)"

endchoice

config APP_libmcu_x1600_I2C0_RATE
    int "       I2C0 速率"
    default 400000
    depends on APP_libmcu_x1600_I2C0_BUS

config APP_libmcu_x1600_I2C1_BUS
    bool "选择 I2C1"

choice "              选择I2C1 GPIO"
    default APP_libmcu_x1600_I2C1_PB_15_16
    depends on APP_libmcu_x1600_I2C1_BUS

config APP_libmcu_x1600_I2C1_PB_15_16
    bool "SDA: GPIO_PB(16)、SCL: GPIO_PB(15)"

config APP_libmcu_x1600_I2C1_PB_19_20
    bool "SDA: GPIO_PB(20)、SCL: GPIO_PB(19)"

endchoice

config APP_libmcu_x1600_I2C1_RATE
    int "       I2C1 速率"
    default 400000
    depends on APP_libmcu_x1600_I2C1_BUS

endmenu # I2C 总线