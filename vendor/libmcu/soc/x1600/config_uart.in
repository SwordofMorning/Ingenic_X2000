
menuconfig APP_libmcu_x1600_uart
    bool "uart 驱动"
    select APP_libmcu_driver_uart

config APP_libmcu_x1600_uart0
    bool "uart 0"

config APP_libmcu_x1600_uart0_rx
    string "    rx gpio"
    choice from APP_uart0_rx_pins
    depends on APP_libmcu_x1600_uart0

config APP_libmcu_x1600_uart0_tx
    string "    tx gpio"
    choice from APP_uart0_tx_pins
    depends on APP_libmcu_x1600_uart0

config APP_libmcu_x1600_uart0_cts
    string "    cts gpio"
    choice from APP_uart0_cts_pins
    depends on APP_libmcu_x1600_uart0

config APP_libmcu_x1600_uart0_rts
    string "    rts gpio"
    choice from APP_uart0_rts_pins
    depends on APP_libmcu_x1600_uart0

config APP_libmcu_x1600_uart1
    bool "uart 1"

config APP_libmcu_x1600_uart1_rx
    string "    rx gpio"
    choice from APP_uart1_rx_pins
    depends on APP_libmcu_x1600_uart1

config APP_libmcu_x1600_uart1_tx
    string "    tx gpio"
    choice from APP_uart1_tx_pins
    depends on APP_libmcu_x1600_uart1

config APP_libmcu_x1600_uart1_cts
    string "    cts gpio"
    choice from APP_uart1_cts_pins
    depends on APP_libmcu_x1600_uart1

config APP_libmcu_x1600_uart1_rts
    string "    rts gpio"
    choice from APP_uart1_rts_pins
    depends on APP_libmcu_x1600_uart1

config APP_libmcu_x1600_uart2
    bool "uart 2"

config APP_libmcu_x1600_uart2_rx
    string "    rx gpio"
    choice from APP_uart2_rx_pins
    depends on APP_libmcu_x1600_uart2

config APP_libmcu_x1600_uart2_tx
    string "    tx gpio"
    choice from APP_uart2_tx_pins
    depends on APP_libmcu_x1600_uart2

config APP_libmcu_x1600_uart2_cts
    string "    cts gpio"
    choice from APP_uart2_cts_pins
    depends on APP_libmcu_x1600_uart2

config APP_libmcu_x1600_uart2_rts
    string "    rts gpio"
    choice from APP_uart2_rts_pins
    depends on APP_libmcu_x1600_uart2


config APP_libmcu_x1600_uart3
    bool "uart 3"

config APP_libmcu_x1600_uart3_rx
    string "    rx gpio"
    choice from APP_uart3_rx_pins
    depends on APP_libmcu_x1600_uart3

config APP_libmcu_x1600_uart3_tx
    string "    tx gpio"
    choice from APP_uart3_tx_pins
    depends on APP_libmcu_x1600_uart3

config APP_libmcu_x1600_uart3_cts
    string "    cts gpio"
    choice from APP_uart3_cts_pins
    depends on APP_libmcu_x1600_uart3

config APP_libmcu_x1600_uart3_rts
    string "    rts gpio"
    choice from APP_uart3_rts_pins
    depends on APP_libmcu_x1600_uart3

endmenu

array APP_uart0_rx_pins
    string "uart0 rx 引脚"
    item "GPIO_PB(7) func0" GPIO_PB(7),GPIO_FUNC_0
    item "GPIO_NULL  " -1

array APP_uart0_tx_pins
    string "uart0 tx 引脚"
    item "GPIO_PB(8) func0" GPIO_PB(8),GPIO_FUNC_0
    item "GPIO_NULL  " -1

array APP_uart0_cts_pins
    string "uart0 cts 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PB(9) func0" GPIO_PB(9),GPIO_FUNC_0

array APP_uart0_rts_pins
    string "uart0 rts 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PB(10) func0" GPIO_PB(10),GPIO_FUNC_0

array APP_uart1_rx_pins
    string "uart1 rx 引脚"
    item "GPIO_PB(3) func1" GPIO_PB(3),GPIO_FUNC_1
    item "GPIO_NULL  " -1

array APP_uart1_tx_pins
    string "uart1 tx 引脚"
    item "GPIO_PB(2) func1" GPIO_PB(2),GPIO_FUNC_1
    item "GPIO_NULL  " -1

array APP_uart1_cts_pins
    string "uart1 cts 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PB(5) func1" GPIO_PB(5),GPIO_FUNC_1

array APP_uart1_rts_pins
    string "uart1 rts 引脚"
    item "GPIO_NULL  " -1
    item "GPIO_PB(4) func1" GPIO_PB(4),GPIO_FUNC_1

array APP_uart2_rx_pins
    string "uart2 rx 引脚"
    item "GPIO_PA(31) func2" GPIO_PA(31),GPIO_FUNC_2
    item "GPIO_PB(1) func1" GPIO_PB(1),GPIO_FUNC_1
    item "GPIO_NULL  " -1

array APP_uart2_tx_pins
    string "uart2 tx 引脚"
    item "GPIO_PA(30) func2" GPIO_PA(30),GPIO_FUNC_2
    item "GPIO_PB(0) func1" GPIO_PB(0),GPIO_FUNC_1
    item "GPIO_NULL  " -1

array APP_uart2_cts_pins
    string "uart2 cts 引脚"
    item "GPIO_NULL  " -1

array APP_uart2_rts_pins
    string "uart2 rts 引脚"
    item "GPIO_NULL  " -1

array APP_uart3_rx_pins
    string "uart3 rx 引脚"
    item "GPIO_PB(5) func0" GPIO_PB(5),GPIO_FUNC_0
    item "GPIO_PD(5) func2" GPIO_PD(5),GPIO_FUNC_2
    item "GPIO_NULL  " -1

array APP_uart3_tx_pins
    string "uart3 tx 引脚"
    item "GPIO_PB(4) func0" GPIO_PB(4),GPIO_FUNC_0
    item "GPIO_PD(4) func2" GPIO_PD(4),GPIO_FUNC_2
    item "GPIO_NULL  " -1

array APP_uart3_tx_pins
    string "uart3 cts 引脚"
    item "GPIO_NULL  " -1

array APP_uart3_cts_pins
    string "uart3 cts 引脚"
    item "GPIO_NULL  " -1

array APP_uart3_rts_pins
    string "uart3 rts 引脚"
    item "GPIO_NULL  " -1

array APP_libmcu_soc_uart_devs
    int "soc uart 列表"
    item "不使用 uart" -1
    item "uart0" 0
    item "uart1" 1
    item "uart2" 2
    item "uart3" 3


