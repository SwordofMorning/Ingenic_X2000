# X2000 SDK repository — Git LFS and line-ending policy
#
# POLICY 1 (line endings): never convert anything.
#   This repository embeds a vendor SDK snapshot whose bytes we must preserve
#   exactly, so that vendor diffs and future vendor patches stay meaningful.
#   "* -text" disables all EOL normalisation; git still auto-detects text files
#   for diffing, so review of source changes is unaffected.
* -text

# POLICY 2 (large files): every non-text artifact goes to Git LFS.
#   Measured LFS payload for this repository: about 529 MB of 2.30 GB imported
#   (archives 336 MB = buildroot dl/ offline sources; images 165 MB = vendor doc
#   assets; binaries 28 MB). No single file is larger than 100 MB.

# --- source archives (buildroot dl/ offline cache; decide offline builds) ---
*.tar filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tar.bz2 filter=lfs diff=lfs merge=lfs -text
*.tar.xz filter=lfs diff=lfs merge=lfs -text
*.tgz filter=lfs diff=lfs merge=lfs -text
*.gz filter=lfs diff=lfs merge=lfs -text
*.bz2 filter=lfs diff=lfs merge=lfs -text
*.xz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text

# --- build artifacts / prebuilt libraries ---
*.bin filter=lfs diff=lfs merge=lfs -text
*.ko filter=lfs diff=lfs merge=lfs -text
*.so filter=lfs diff=lfs merge=lfs -text
*.a filter=lfs diff=lfs merge=lfs -text
*.o filter=lfs diff=lfs merge=lfs -text
*.elf filter=lfs diff=lfs merge=lfs -text
*.img filter=lfs diff=lfs merge=lfs -text
*.dat filter=lfs diff=lfs merge=lfs -text

# --- vendor documentation assets (doc/.Markdown/**/*.assets/) ---------------
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.bmp filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.ttc filter=lfs diff=lfs merge=lfs -text

# --- wireless firmware blobs (wireless/bcm/firmware/**) --------------------
*.hcd filter=lfs diff=lfs merge=lfs -text
